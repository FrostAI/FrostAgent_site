{
  "name": "frostagent-site",
  "version": "1.0.0",
  "private": true,
  "description": "FrostAgent 官网与 VitePress 文档站",
  "scripts": {
    "dev": "npm run docs:build && eleventy --serve --port=4321",
    "build": "eleventy && npm run docs:build",
    "check": "npm run docs:check && npm run test:docs && node scripts/check-site.cjs && node scripts/check-docs.cjs",
    "test:docs": "node --test scripts/docs-navigation.test.mjs",
    "test:scroll": "node --test scripts/section-scroll.test.cjs",
    "update:contributors": "node scripts/update-contributors.cjs",
    "docs:dev": "npm run dev --workspace @frostagent/docs",
    "docs:build": "npm run build --workspace @frostagent/docs",
    "docs:preview": "npm run preview --workspace @frostagent/docs",
    "docs:check": "npm run check --workspace @frostagent/docs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2"
  },
  "workspaces": [
    "docs"
  ]
}
